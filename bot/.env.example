# ============================================
# Telegram Bot Configuration
# ============================================
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://crm_user:your_secure_password@localhost:5432/crm_bot

# ============================================
# CRM Integration
# ============================================
# CRM host - just specify your domain or host:port
# The system automatically determines HTTP/HTTPS:
#   - Domains without port use HTTPS: "crm.example.com" -> https://crm.example.com
#   - localhost/IP with port use HTTP: "localhost:5173" -> http://localhost:5173
#   - Full URLs also work: "https://crm.example.com"
# Examples:
#   CRM_HOST=crm.example.com        # Production (HTTPS)
#   CRM_HOST=localhost:5173         # Development (HTTP)
CRM_HOST=localhost:5173

# ============================================
# Internal API Authentication
# ============================================
# Shared secret for service-to-service auth between SvelteKit and Bot
# MUST be identical in both site/.env and bot/.env
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_random_secret

# ============================================
# Webhook Server Configuration
# ============================================
# Webhook server for receiving messages from CRM
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081

# ============================================
# Redis / Dragonfly (FSM persistence)
# ============================================
# Redis URL for distributed FSM storage (optional, falls back to MemoryStorage)
REDIS_URL=redis://localhost:6379

# ============================================
# Cloudflare R2 Object Storage (Optional)
# ============================================
# If set, bot uploads photos directly to R2 instead of proxying through SvelteKit.
# Falls back to SvelteKit proxy if not configured.
# Get credentials from Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=