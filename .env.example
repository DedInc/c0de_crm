# ============================================
# Docker Compose Environment Variables
# ============================================
# This file contains environment variables for docker-compose.yml
# Copy this file to .env and update with your actual values

# ============================================
# PostgreSQL Database Configuration
# ============================================
# SECURITY WARNING: Change these default values in production!
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=crm_bot

# ============================================
# Telegram Bot Token
# ============================================
BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# Dragonfly (Redis-compatible cache) Password
# ============================================
# Password for the Dragonfly in-memory data store
# Generate with: openssl rand -hex 32
DRAGONFLY_PASSWORD=change_me_in_production

# ============================================
# Internal API Authentication
# ============================================
# Shared secret for CRM <-> Bot communication
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_random_secret

# ============================================
# Public URL
# ============================================
CRM_BASE_URL=http://localhost:3000

# ============================================
# Reverse Proxy / Login Security
# ============================================
# Keep login throttling fail-closed in deployed environments.
LOGIN_RATE_LIMIT_FAIL_CLOSED=true
UPLOAD_RATE_LIMIT_FAIL_CLOSED=true
UPLOAD_RATE_LIMIT_MAX_PER_USER=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
UPLOAD_MAX_PER_ORDER_PER_DAY=100
MAX_CHAT_SSE_TOTAL_CONNECTIONS=1000
MAX_CHAT_SSE_CONNECTIONS_PER_ORDER=50
DB_STATEMENT_TIMEOUT_MS=30000

# Adapter-node reads the trusted client IP from the right side of X-Forwarded-For.
# Only enable when traffic reaches crm_web exclusively through a trusted proxy.
XFF_DEPTH=1

# ============================================
# Bot Direct R2 Upload (Optional)
# ============================================
# If set, bot uploads photos directly to R2 instead of proxying through SvelteKit.
# Falls back to SvelteKit proxy if not configured.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
