# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection URL (REQUIRED)
# Format: postgresql://username:password@host:port/database
# SECURITY WARNING: Use a strong password in production!
DATABASE_URL=postgresql://crm_user:your_secure_password@localhost:5432/crm_bot

# ============================================
# Admin Account (first run only)
# ============================================
# If not set, a random password is generated and printed to the console
# ADMIN_DEFAULT_PASSWORD=your_chosen_admin_password

# ============================================
# Bot Integration
# ============================================
# Bot webhook URL for sending messages to customers via Telegram
# This should point to your bot's webhook server
BOT_WEBHOOK_URL=http://localhost:8081

# Telegram Bot Token (used for proxying customer images securely)
# Must match the bot token used by the bot service
BOT_TOKEN=your_bot_token_here

# ============================================
# Internal API Authentication
# ============================================
# Shared secret for service-to-service auth between SvelteKit and Bot
# MUST be identical in both site/.env and bot/.env
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_random_secret

# ============================================
# Public URLs
# ============================================
# CRM base URL (used for generating order links in notifications)
# This should be the public URL of your CRM site
# Production example: https://crm.example.com
CRM_BASE_URL=http://localhost:5173

# ============================================
# Cache Configuration (Redis/Dragonfly)
# ============================================
# Set to 'true' to enable caching, 'false' to disable
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# Login rate limiting uses Redis and fails closed by default.
# Set to 'false' only for local development without Redis.
LOGIN_RATE_LIMIT_FAIL_CLOSED=true

# Upload throttling and per-order quota.
UPLOAD_RATE_LIMIT_FAIL_CLOSED=true
UPLOAD_RATE_LIMIT_MAX_PER_USER=60
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
UPLOAD_MAX_PER_ORDER_PER_DAY=100

# Redis connection settings
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# ============================================
# Database Connection Pool Settings
# ============================================
# Conservative settings to prevent connection exhaustion
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=30000
# Optional PostgreSQL server-side statement timeout in milliseconds.
# Set to 0 or leave unset to disable.
DB_STATEMENT_TIMEOUT_MS=30000

# ============================================
# Cloudflare R2 Object Storage
# ============================================
# Required for file uploads (chat images, attachments)
# Get credentials from Cloudflare dashboard → R2 → Manage R2 API tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=crm-files

# ============================================
# SvelteKit Server
# ============================================
# Maximum request body size (default: 512K — too small for file uploads)
# Must accommodate MAX_FILE_SIZE (10MB) + multipart overhead
BODY_SIZE_LIMIT=15M

# Reverse proxy client address settings for @sveltejs/adapter-node.
# Configure these only when the app is reachable exclusively through a trusted proxy.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Per-process chat SSE connection caps.
MAX_CHAT_SSE_TOTAL_CONNECTIONS=1000
MAX_CHAT_SSE_CONNECTIONS_PER_ORDER=50

# ============================================
# Database SSL (Production)
# ============================================
# CA certificate for SSL database connections (optional)
# Only needed when connecting to remote/cloud PostgreSQL with SSL
# DB_CA_CERT=your_ca_certificate_content